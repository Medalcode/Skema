# Environment Configuration for Skema
# Copy to .env and adjust values as needed

# Database
DATABASE_URL=postgresql://skema:skema@localhost:5432/skema_db
SQL_ECHO=false

# API
API_HOST=0.0.0.0
API_PORT=8000

# Environment
ENVIRONMENT=development
DEBUG=true

# Model Configuration
CLASSIFIER_MODEL=hybrid  # options: dummy, hybrid, openai
CONFIDENCE_THRESHOLD=0.60

# Embeddings
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO
